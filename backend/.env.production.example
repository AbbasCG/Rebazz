# Productie-instellingen voor Rebazz (Laravel + React). Kopieer naar .env op de server en vul de lege waarden in.
# NOOIT committen of publiek hosten. Gebruik lange, willekeurige wachtwoorden.

APP_NAME=Rebazz
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_URL=https://rebazz.nl
FRONTEND_URL=https://rebazz.nl

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Eén database-engine overal: PostgreSQL (migraties gebruiken jsonb).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rebazz
DB_USERNAME=rebazz
DB_PASSWORD=

# De API is stateless (bearer-tokens); geen databasesessies nodig.
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync         # er worden nu geen jobs in een wachtrij gezet; geen worker nodig

# E-mail: zonder echte mailer ontvangen klanten geen statusmails en krijg je geen CJ-alerts.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="info@rebazz.nl"
MAIL_FROM_NAME="Rebazz"
OWNER_ALERT_EMAIL=info@rebazz.nl

# ---- Rebazz ----
ADMIN_PASSWORD=               # minimaal 20 willekeurige tekens
STRIPE_SECRET=                # sk_live_...
STRIPE_WEBHOOK_SECRET=        # whsec_... (endpoint: https://rebazz.nl/api/stripe/webhook)
STRIPE_TAX=on                 # verplicht in live-modus: anders wordt geen btw berekend
CJ_API_KEY=
CJ_AUTO_PAY=off               # zet pas 'on' na tests; betaalt bestellingen automatisch van je CJ-saldo

# Webhook-events die in Stripe geactiveerd moeten zijn:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   charge.refunded, charge.dispute.created
#
# Server-taken:
#   cron:    * * * * * cd /pad/naar/backend && php artisan schedule:run >> /dev/null 2>&1

# Margebewaking en kortingscodes
SHOP_ALLOW_PROMO=on
SHOP_MIN_MARGIN_PERCENT=15    # niet automatisch bestellen als ontvangen bedrag (excl. btw) < inkoop + 15%
SHOP_ABANDONED_CART=on       # herinnering bij verlaten kassa, alleen na toestemming in de Stripe-kassa (off = uit)
SHOP_REQUIRE_GPSR=on          # actieve producten vereisen fabrikant + EU-verantwoordelijke (GPSR)

# Achter nginx/Cloudflare/load balancer: IP-adres van de proxy (of * als alleen die bij u kan binnenkomen).
TRUSTED_PROXIES=

# Retourtermijn in dagen vanaf aflevering (wettelijk minimaal 14; de winkel belooft 30)
SHOP_RETURN_DAYS=30

# AVG: bewaartermijn bestel- en factuurgegevens in jaren (Nederland: 7)
SHOP_RETENTION_YEARS=7
